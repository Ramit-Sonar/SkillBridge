{
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "https://skillbridge-tbk8.onrender.com/socket.io/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://skillbridge-tbk8.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
